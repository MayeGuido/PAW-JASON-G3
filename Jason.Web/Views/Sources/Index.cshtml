@model IReadOnlyList<Jason.Models.Dtos.SourceDto>
@{
    ViewData["Title"] = "Fuentes";
}

<h1>Fuentes</h1>
<p class="text-muted">Pantalla de prueba que confirma que la Web llega a la API y a la base de datos.</p>

@if (ViewBag.Error is string error)
{
    <div class="alert alert-warning">@error</div>
}
else if (!Model.Any())
{
    <div class="alert alert-info">Todavía no hay fuentes. Corre Database/02_seed_sources.sql para cargar unas de ejemplo.</div>
}
else
{
    <table class="table">
        <thead>
            <tr><th>Nombre</th><th>Tipo</th><th>URL</th><th>Requiere secret</th></tr>
        </thead>
        <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td>@s.Name</td>
                    <td>@s.ComponentType</td>
                    <td>@s.Url</td>
                    <td>@(s.RequiresSecret ? "Sí" : "No")</td>
                </tr>
            }
        </tbody>
    </table>
}
