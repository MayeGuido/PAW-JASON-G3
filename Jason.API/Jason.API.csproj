    <Content Include="..\docs\formato-json\schema.json" Link="Schemas\schema.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Jason.Models\Jason.Models.csproj" />
    <ProjectReference Include="..\Jason.DataAccess\Jason.DataAccess.csproj" />
    <ProjectReference Include="..\Jason.Architecture\Jason.Architecture.csproj" />
  </ItemGroup>

</Project>
